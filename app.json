{
  "expo": {
    "name": "Memory Ticket",
    "slug": "memory-ticket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "memoryticket",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F5EDE3",
    "ios": {
      "supportsTablet": false,
      "backgroundColor": "#F5EDE3",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5EDE3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "backgroundColor": "#F5EDE3",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#F5EDE3"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5EDE3"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Access your photos to preserve memories as collectible tickets.",
          "savePhotosPermission": "Save your memory tickets to the photo library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to create beautiful memory tickets."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
